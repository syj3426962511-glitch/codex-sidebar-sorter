<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>../src/Assets/聊天排序.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WindowsUiTests.cs" />
    <Compile Include="FixtureNativeServer.cs" />
    <Compile Include="../src/*.cs" Exclude="../src/Program.cs" />
    <EmbeddedResource Include="../src/Assets/English.json" LogicalName="SidebarSorter.English" />
    <EmbeddedResource Include="../src/Assets/聊天排序-Logo-256.png" LogicalName="SidebarSorter.BrandLogo" />
  </ItemGroup>
</Project>
