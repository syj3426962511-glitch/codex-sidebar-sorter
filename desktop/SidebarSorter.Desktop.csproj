<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SidebarSorter</AssemblyName>
    <Version>1.5.1</Version>
    <ApplicationIcon>../src/Assets/sidebar-sorter.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <Compile Include="../src/SorterService.cs" />
    <Compile Include="../src/NativeBridge.cs" />
    <Compile Include="../src/LocalHistoryReader.cs" />
    <Compile Include="../src/WorkspacePreview.cs" />
    <Compile Include="../src/Localization.cs" />
    <Compile Include="../src/ToolSettings.cs" />
    <Compile Include="../src/AutomaticSorter.cs" />
    <Compile Include="../src/IndependentLaunch.cs" />
    <EmbeddedResource Include="../src/Assets/English.json" LogicalName="SidebarSorter.English" />
    <EmbeddedResource Include="../src/Assets/Languages.json" LogicalName="SidebarSorter.Languages" />
    <AvaloniaResource Include="../src/Assets/sidebar-sorter.ico" Link="Assets/app.ico" />
    <AvaloniaResource Include="../src/Assets/sidebar-sorter-logo-256.png" Link="Assets/logo.png" />
    <None Include="../src/Assets/sidebar-sorter-logo-256.png" Link="tray.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../src/Assets/sidebar-sorter.ico" Link="tray.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(CloudSmoke)' == 'true'">
    <OutputType>Exe</OutputType>
    <StartupObject>SidebarSorter.DesktopSmokeTests</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(CloudSmoke)' == 'true'">
    <Compile Include="../tests/DesktopSmokeTests.cs" />
    <Compile Include="../tests/FixtureNativeServer.cs" />
  </ItemGroup>
</Project>
